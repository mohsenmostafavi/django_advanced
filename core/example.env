# ==========================================
# تنظیمات اصلی جنگو (Django Core Settings)
# ==========================================
# کلید مخفی جنگو. در محیط واقعی باید یک رشته تصادفی و بسیار طولانی باشد.
# هرگز کلید واقعی خود را در این فایل قرار ندهید.
SECRET_KEY=your-super-secret-django-key-here

# حالت دیباگ. در محیط توسعه True و در محیط پروداکشن حتماً False باشد.
DEBUG=True

# لیست دامنه‌ها یا IPهای مجاز برای دسترسی به سایت (حتماً با کاما جدا شوند)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# تنظیمات دیتابیس PostgreSQL (برای پروداکشن)
# ==========================================
DB_NAME=your_postgres_db_name
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# تنظیمات دیتابیس SQLite (برای محیط توسعه لوکال)
# ==========================================
SQLITE_DB_NAME=db.sqlite3

# ==========================================
# تنظیمات سرور و شبکه
# ==========================================
# پورتی که اپلیکیشن روی آن اجرا می‌شود (عدد صحیح / Integer)
PORT=8000

# زمان انتظار یا Timeout بر حسب ثانیه (عدد اعشاری / Float)
TIMEOUT=5.5